# ==============================================================================
# SMS IR-RIS (Interventional Radiology Radiology Information System)
# Environment Configuration Template
# Sawai Man Singh (SMS) Medical College & Attached Hospitals, Jaipur
# ==============================================================================

# Node Environment
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://sms-ir.health.rajasthan.gov.in"

# Departmental Metadata
NEXT_PUBLIC_INSTITUTION_NAME="Sawai Man Singh (SMS) Medical College & Attached Hospitals, Jaipur"
NEXT_PUBLIC_DEPARTMENT_NAME="Department of Radiodiagnosis & Interventional Radiology"
NEXT_PUBLIC_CATHLAB_1="Cath Lab 1 (Siemens Artis Zee - Vascular & Neuro)"
NEXT_PUBLIC_CATHLAB_2="Cath Lab 2 (Philips Azurion - Body & Oncology)"

# PostgreSQL Database (Supabase / Neon / AWS RDS / Self-Hosted PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/sms_ir_ris?schema=public"

# NextAuth v5 Authentication & Session Security
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_minimum_32_chars_long_here"
NEXTAUTH_URL="http://localhost:3000"

# Patient Data Privacy & Encryption (HIPAA / DISHA / DPDP Compliance)
# 32-byte AES key used for cryptographic tokenization of National Health IDs (Jan-Aadhaar / ABHA)
HEALTH_ID_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Meta WhatsApp Cloud API (Preoperative D-1 Advisories & Biopsy Pathology Recalls)
WHATSAPP_CLOUD_API_TOKEN="EAABw..."
WHATSAPP_PHONE_NUMBER_ID="109827364512345"
WHATSAPP_BUSINESS_ACCOUNT_ID="108726354129876"

# Rajasthan Government Health Scheme (RGHS & MAAY) SMS Gateway Integration
RAJASTHAN_HEALTH_GATEWAY_URL="https://health.rajasthan.gov.in/api/v2"
RAJASTHAN_HEALTH_GATEWAY_API_KEY="sec_sms_ir_gateway_token_prod"

# OCR / Tesseract Worker Optimization
TESSERACT_WORKER_CONCURRENCY=2
MAX_UPLOAD_SIZE_MB=15
