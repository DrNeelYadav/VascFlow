{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@vascule/ui-kit": [
        "../../packages/ui-kit/src"
      ],
      "@vascule/ui-kit/*": [
        "../../packages/ui-kit/src/*"
      ],
      "@vascule/feature-patient-vitals": [
        "../../packages/features/patient-vitals/src"
      ],
      "@vascule/feature-patient-vitals/*": [
        "../../packages/features/patient-vitals/src/*"
      ],
      "@vascule/feature-ot-scheduling": [
        "../../packages/features/ot-scheduling/src"
      ],
      "@vascule/feature-ot-scheduling/*": [
        "../../packages/features/ot-scheduling/src/*"
      ],
      "@vascule/feature-dicom-viewer": [
        "../../packages/features/dicom-viewer/src"
      ],
      "@vascule/feature-dicom-viewer/*": [
        "../../packages/features/dicom-viewer/src/*"
      ],
      "@vascule/feature-scheme-billing": [
        "../../packages/features/scheme-billing/src"
      ],
      "@vascule/feature-scheme-billing/*": [
        "../../packages/features/scheme-billing/src/*"
      ],
      "@vascule/catalog": [
        "../../packages/catalog/src"
      ],
      "@vascule/catalog/*": [
        "../../packages/catalog/src/*"
      ],
      "@vascule/utils": [
        "../../packages/utils/src"
      ],
      "@vascule/utils/*": [
        "../../packages/utils/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
