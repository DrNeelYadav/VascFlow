datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id            String         @id @default(cuid())
  hospitalName  String
  region        String
  activeStatus  Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  staff         Staff[]
  patients      Patient[]
  scheduleSlots ScheduleSlot[]
  auditLogs     AuditLog[]
  uatFeedbacks  UatFeedback[]
}

model Staff {
  id         String     @id @default(cuid())
  tenantId   String     @default("tenant_sms_jaipur")
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  roleCode   String
  name       String
  title      String
  email      String     @unique
  roleTier   String
  department String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  auditLogs  AuditLog[]

  @@index([tenantId])
}

model Patient {
  id              String   @id @default(cuid())
  tenantId        String   @default("tenant_sms_jaipur")
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  crNo            String   @unique
  ipdNo           String
  name            String
  age             Int
  gender          String
  weightKg        Float
  serumCreatinine Float
  totalBilirubin  Float
  serumAlbumin    Float
  inr             Float
  sodiumMeqL      Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model ScheduleSlot {
  id            String   @id @default(cuid())
  tenantId      String   @default("tenant_sms_jaipur")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  suiteName     String
  patientId     String
  procedureType String
  operatorName  String
  priority      String   @default("ELECTIVE")
  scheduledTime DateTime
  status        String   @default("SCHEDULED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([patientId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String   @default("tenant_sms_jaipur")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  action      String
  entityType  String
  entityId    String
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id])
  ipAddress   String
  userAgent   String
  detailsJson String
  timestamp   DateTime @default(now())

  @@index([tenantId])
  @@index([staffId])
}

model UatFeedback {
  id              String   @id @default(cuid())
  tenantId        String   @default("tenant_sms_jaipur")
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  staffId         String
  staffName       String
  roleTier        String
  deviceType      String
  clinicalModule  String
  workflowRating  Int
  uiClutterRating Int
  feedbackText    String
  category        String
  priority        String
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([clinicalModule])
  @@index([status])
}
