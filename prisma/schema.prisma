datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  FACULTY
  RESIDENT
  NURSE
  TECH
}

enum StaffPersonaCode {
  FC01 // Prof. & HOD
  FC02 // Dr. Gupta (Assoc. Prof)
  DM01 // Dr. Sharma (Fellow)
  DM02 // Dr. Verma (Fellow)
  SR01 // Dr. Choudhary (SR)
  NO01 // Sr. Sister Sunita (NO)
  NO02 // Staff Nurse Anita (NO)
  TC01 // Vikram Singh (Tech)
  TC02 // Ramesh Kumar (Tech)
  CR01 // Rajesh Meena (Scheme Desk)
}

enum SchemeType {
  MAAY_CHIRANJEEVI
  RGHS
  RAJSICK
  PMJAY
  BSBY
  RAILWAY
  GENERAL_PAID
}

enum BookingStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED
}

enum BiopsyModality {
  D9211_CT
  ROOM_922_USG
}

enum BiopsyStatus {
  PENDING_PATHOLOGY
  COMPLETED
  LOST_TO_FOLLOWUP
  INADEQUATE_REPEAT_RECOMMENDED
}

model User {
  id           String           @id @default(cuid())
  personaCode  StaffPersonaCode @unique
  name         String
  title        String
  role         UserRole
  dept         String
  pinHash      String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdBookings ScheduleSlot[] @relation("BookingCreator")
  biopsiesLogged  BiopsyLog[]    @relation("BiopsyOperator")
  proceduresDone  Procedure[]    @relation("ProcedureOperator")

  @@index([role])
}

model Patient {
  id                    String      @id @default(cuid())
  crNo                  String      @unique
  ipdNo                 String
  name                  String
  age                   Int
  gender                String
  bedNo                 String
  phone                 String?
  nationalHealthIdHash  String?     @unique // SHA-256 Hash of National Health ID / Jan Aadhaar for HIPAA/SOC2 compliance
  weightKg              Float
  serumCreatinine       Float
  totalBilirubin        Float?
  serumAlbumin          Float?
  inr                   Float?
  sodiumMeqL            Float?
  plateletCount         Float?
  scheme                SchemeType  @default(MAAY_CHIRANJEEVI)
  schemeTid             String?
  diagnosis             String
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  bookings    ScheduleSlot[]
  procedures  Procedure[]
  biopsies    BiopsyLog[]
  patientLogEntries PatientLogEntry[]

  @@index([crNo])
  @@index([nationalHealthIdHash])
}

model ScheduleSlot {
  id                    String        @id @default(cuid())
  patientId             String
  patient               Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  angiosuite            String        @default("Cath Lab 1 (Siemens Artis Zee)")
  targetDate            DateTime
  slotTime              String
  isEmergency           Boolean       @default(false)
  isHolidayOverride     Boolean       @default(false)
  holidayOverrideReason String?
  d1CallCompleted       Boolean       @default(false)
  status                BookingStatus @default(SCHEDULED)
  hardwareIndented      String?
  vendorContact         String?
  notes                 String?
  createdById           String?
  createdBy             User?         @relation("BookingCreator", fields: [createdById], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([targetDate])
  @@index([status])
}

model Procedure {
  id                  String    @id @default(cuid())
  patientId           String
  patient             Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedureCode       String
  procedureName       String
  accessSite          String    // e.g. Right Common Femoral Artery, Right IJV
  sheathSize          String    // e.g. 5F, 6F
  catheterUsed        String?   // e.g. 5F Roberts Uterine, 2.7F Progreat
  contrastVolumeMl    Float     // Contrast tracked for Cigarroa MACD limit
  fluoroscopyMinutes  Float?
  dapGyCm2            Float?    // Dose Area Product radiation metric
  complications       String?
  hemostasisMethod    String?   // e.g. Manual Compression, Angio-Seal 6F
  operatorId          String?
  operator            User?     @relation("ProcedureOperator", fields: [operatorId], references: [id])
  performedAt         DateTime  @default(now())
  createdAt           DateTime  @default(now())

  @@index([patientId])
  @@index([procedureCode])
}

model BiopsyLog {
  id                      String         @id @default(cuid())
  patientId               String
  patient                 Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  modality                BiopsyModality @default(D9211_CT)
  organ                   String         // e.g. Lung, Liver, Retroperitoneal Node
  needleGauge             String         // e.g. 18G Coaxial, 16G Temno
  coresCount              Int            @default(2)
  operatorId              String?
  operator                User?          @relation("BiopsyOperator", fields: [operatorId], references: [id])
  pathLab                 String         @default("SMS Central Pathology")
  status                  BiopsyStatus   @default(PENDING_PATHOLOGY)
  diagnosticYield         Boolean        @default(true)
  histopathologyDiagnosis String?
  complicationNoted       String?        // e.g. Trace pneumothorax, none
  performedAt             DateTime       @default(now())
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([modality])
  @@index([status])
  @@index([patientId])
}

model ProcedureBlueprint {
  id                    String            @id @default(cuid())
  name                  String            @unique
  procedureType         String            @unique
  category              String
  code                  String
  rghsCode              String?
  icd10                 String
  defaultFollowupType   String            @default("Imaging (CT/MR/USG)")
  defaultIntervalNumber Int               @default(4)
  defaultIntervalUnit   String            @default("Weeks")
  indications           String[]          @default([])
  preOpCriteria         String[]          @default([])
  techniqueSteps        String[]          @default([])
  complications         String[]          @default([])
  vendorContacts        String[]          @default([])
  baseTariffInr         Float             @default(0.0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  hardware              HardwareIndent[]
  tariffs               SchemeTariff[]
  patientLogs           PatientLogEntry[]

  @@index([procedureType])
  @@index([category])
  @@index([code])
}

model HardwareIndent {
  id                    String              @id @default(cuid())
  procedureBlueprintId  String
  procedureBlueprint    ProcedureBlueprint  @relation(fields: [procedureBlueprintId], references: [id], onDelete: Cascade)
  category              String
  itemName              String
  specification         String
  standardStore         String
  estimatedCostInr      Float?
  isImplant             Boolean             @default(false)
  implantCode           String?
  createdAt             DateTime            @default(now())

  @@index([procedureBlueprintId])
  @@index([category])
  @@index([standardStore])
}

model SchemeTariff {
  id                    String              @id @default(cuid())
  procedureBlueprintId  String
  procedureBlueprint    ProcedureBlueprint  @relation(fields: [procedureBlueprintId], references: [id], onDelete: Cascade)
  scheme                SchemeType          @default(MAAY_CHIRANJEEVI)
  schemeName            String
  packageCode           String
  packageName           String
  tariffAmount          Float
  nabhRate              Float?
  nonNabhRate           Float?
  implantCovered        Boolean             @default(false)
  implantDetails        Json?
  preAuthCriteria       String?
  documentationChecklist String[]           @default([])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([procedureBlueprintId])
  @@index([packageCode])
  @@index([scheme])
}

model PatientLogEntry {
  id                        String              @id @default(cuid())
  uhid                      String
  patientName               String
  age                       Int
  sex                       String
  contactNumber             String
  alternateContact          String?
  referringDoctor           String
  diagnosis                 String
  procedureTypeId           String?
  procedureBlueprint        ProcedureBlueprint? @relation(fields: [procedureTypeId], references: [id])
  procedureType             String
  procedureDate             DateTime
  admissionStatus           String              @default("Day Care")
  dischargeDate             DateTime?
  operator                  String
  accessionNo               String?
  anesthesia                String              @default("Local")
  preProcCreatinine         Float?
  preProcInrPlatelets       String?
  contrastVolumeMl          Float               @default(0.0)
  immediateComplication     String              @default("None")
  technicalSuccess          String              @default("Yes")
  deviceMaterialUsed        String
  histopathologyStatus      String              @default("N/A")
  suggestedFollowupType     String
  suggestedFollowupInterval String
  followupType              String
  intervalNumber            Int                 @default(4)
  intervalUnit              String              @default("Weeks")
  followupDueDate           DateTime?
  followupStatus            String              @default("Pending")
  followupDoneDate          DateTime?
  clinicalOutcome           String              @default("N/A")
  followupOutcomeNotes      String?
  nextFollowupDue           DateTime?
  patientStatus             String              @default("Active")
  payerScheme               String              @default("Chiranjeevi")
  remarks                   String?
  dateAdded                 DateTime            @default(now())
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  patientId                 String?
  patient                   Patient?            @relation(fields: [patientId], references: [id])

  @@index([uhid])
  @@index([procedureDate])
  @@index([procedureType])
  @@index([operator])
  @@index([followupStatus])
  @@index([followupDueDate])
}

model ClinicalGuideline {
  id                         String   @id @default(cuid())
  code                       String   @unique // e.g. CIRSE-TACE-2024, SIR-PTBD-2023, RERC-EVLA-2022
  society                    String   // CIRSE, SIR, RERC
  procedureName              String   // Transarterial Chemoembolization, Percutaneous Transhepatic Biliary Drainage, Endovenous Laser Ablation
  title                      String
  year                       Int
  evidenceGrade              String   // e.g. Grade 1A, Level II-b
  indications                String[]
  contraindications          String[]
  technicalSuccessThreshold  Float    // percentage threshold e.g. 95.0
  majorComplicationThreshold Float    // percentage threshold e.g. 3.0
  antibioticProphylaxis      String
  preProcedureChecklist      String[]
  postProcedureCare          String[]
  gradingCriteria            Json     // Structured CIRSE / Clavien-Dindo complication grading
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([society])
  @@index([procedureName])
}

model Staff {
  id         String     @id @default(cuid())
  roleCode   String
  name       String
  title      String
  email      String     @unique
  roleTier   String
  department String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  auditLogs  AuditLog[]
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id])
  ipAddress   String
  userAgent   String
  detailsJson String
  timestamp   DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([staffId])
  @@index([timestamp])
}

