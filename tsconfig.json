{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/auth": [
        "apps/web-app/auth.ts"
      ],
      "@/*": [
        "apps/web-app/*"
      ],
      "@vascule/ui-kit": [
        "packages/ui-kit/src"
      ],
      "@vascule/ui-kit/*": [
        "packages/ui-kit/src/*"
      ],
      "@vascule/feature-patient-vitals": [
        "packages/features/patient-vitals/src"
      ],
      "@vascule/feature-patient-vitals/*": [
        "packages/features/patient-vitals/src/*"
      ],
      "@vascule/feature-ot-scheduling": [
        "packages/features/ot-scheduling/src"
      ],
      "@vascule/feature-ot-scheduling/*": [
        "packages/features/ot-scheduling/src/*"
      ],
      "@vascule/catalog": [
        "packages/catalog/src"
      ],
      "@vascule/catalog/*": [
        "packages/catalog/src/*"
      ],
      "@vascule/utils": [
        "packages/utils/src"
      ],
      "@vascule/utils/*": [
        "packages/utils/src/*"
      ],
      "@vascule/feature-dicom-viewer": [
        "packages/features/dicom-viewer/src"
      ],
      "@vascule/feature-dicom-viewer/*": [
        "packages/features/dicom-viewer/src/*"
      ],
      "@vascule/db": [
        "packages/db/index.ts"
      ],
      "@vascule/db/*": [
        "packages/db/*"
      ]
    },
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "apps/web-app/**/*.ts",
    "apps/web-app/**/*.tsx",
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}